/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "3d-scraper-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-17",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// Draw-day precision fetching:
	// - Every minute from 08:00–09:59 UTC (2:00 PM – 3:59 PM MMT) on draw days (1st & 16th)
	//   → catches the Thai GLO result the moment Sanook live publishes it (~3:15:10 PM MMT)
	// - Rapid sub-minute catch-up is handled internally by processDraw (fast-poll loop)
	// - Regular 6-hour background sync checks
	"triggers": {
		"crons": ["*/1 8 1,16 * *", "*/1 9 1,16 * *", "0 */6 * * *"]
	},

	// Non-secret environment variables
	"vars": {
		"FIREBASE_DB_URL": "https://d-ledger-8c1e4-default-rtdb.asia-southeast1.firebasedatabase.app",
		"TELEGRAM_CHAT_ID": "5684146708"
	}
}