/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "3d-scraper-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-17",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// Run every 5 minutes on draw days (1st and 16th of each month) between 14:30 - 16:30 Indochina / 2:00 PM - 4:00 PM MMT (08:00 - 09:55 UTC)
	// and regular 6-hour background sync checks
	"triggers": {
		"crons": ["*/5 8 1,16 * *", "*/5 9 1,16 * *", "0 */6 * * *"]
	},

	// Non-secret environment variables
	"vars": {
		"FIREBASE_DB_URL": "https://d-ledger-8c1e4-default-rtdb.asia-southeast1.firebasedatabase.app",
		"TELEGRAM_CHAT_ID": "5684146708"
	}
}