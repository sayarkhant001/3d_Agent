/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "3d-scraper-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-17",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// Run at 11:05 UTC (5:35 PM Myanmar time) to capture 4:30 PM Thai market close
	// Also run at 05:35 UTC (12:05 PM Myanmar) for the morning session close
	"triggers": {
		"crons": ["35 5 * * 1-5", "5 11 * * 1-5"]
	},

	// Non-secret environment variables
	"vars": {
		"FIREBASE_DB_URL": "https://d-ledger-8c1e4-default-rtdb.asia-southeast1.firebasedatabase.app",
		"TELEGRAM_CHAT_ID": "5684146708"
	}
}